# Database connection string (PostgreSQL / Neon)
DATABASE_URL="postgresql://user:password@localhost:5432/taj_price_intelligence?schema=public"

# Application Environment
NODE_ENV="development"
PORT=3000

# Security: Admin Secret for restricted operations per 04-API-AND-SECURITY.md §3
ADMIN_API_KEY="replace_with_secure_random_key_in_production"

# Agent Worker Configuration
AGENT_CONCURRENCY=5
FETCH_TIMEOUT_MS=30000
MAX_RETRIES=2

# Gemini API Key for Natural Language Assistant & Explanations (04-API-AND-SECURITY.md §4)
GEMINI_API_KEY="your_gemini_api_key_here"
